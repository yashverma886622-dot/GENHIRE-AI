# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string.
# If omitted or unreachable, GenHire automatically falls back to seeded in-memory demo mode.
MONGODB_URI="mongodb+srv://yashverma886622_db_user:yashverma02022008@yash.lsyacqf.mongodb.net/smartcampus?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing user authentication JWT tokens.
JWT_SECRET="genhire-super-secret-jwt-key-2026"

# PORT: Server port (defaults to 3000)
PORT=3000
